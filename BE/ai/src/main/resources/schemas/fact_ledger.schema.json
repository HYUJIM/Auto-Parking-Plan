{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.local/schemas/fact_ledger.schema.json",
  "title": "사실 원장 (fact_ledger@1.0)",
  "description": "규칙(또는 검토 항목) 하나에 대해 '설명에 등장할 수 있는 사실'과 '반드시 설명해야 할 사실'을 원자 단위로 적은 정답지. 원문 조문에서 결정적 추출기가 후보를 뽑고, 사람이 승격·제외해 승인한다. 엔진 계산값(대지면적, 참고값, 상태)도 origin=engine 으로 포함한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "rule_ids", "provision_ids", "facts", "dismissed", "review_status"],
  "properties": {
    "schema_version": { "const": "fact_ledger@1.0" },
    "ledger_id": { "type": "string" },
    "rule_ids": { "type": "array", "items": { "type": "string" } },
    "provision_ids": { "type": "array", "items": { "type": "string" } },
    "review_status": { "enum": ["draft", "approved", "superseded"] },
    "facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_id", "kind", "origin", "quote", "must_mention"],
        "properties": {
          "fact_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
          "kind": { "enum": ["PERIOD", "QUANTITY", "DATE", "REFERENCE", "SUBJECT", "CONDITION", "EXCEPTION", "MODALITY", "STATUS"] },
          "origin": { "enum": ["provision", "engine"] },
          "provision_id": { "type": ["string", "null"] },
          "quote": { "type": "string", "description": "원문 그대로의 짧은 구간 (engine 사실은 계산식 설명)" },
          "candidate_ids": { "type": "array", "items": { "type": "string" }, "description": "이 사실이 덮는 원문 후보 (완전성 검사용)" },
          "canonical": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["dim", "value", "unit", "comparator"],
            "properties": {
              "dim": { "type": "string", "description": "period_month | period_day | ratio | area | length | count_vehicle | floors | households | money | date ..." },
              "value": { "type": ["number", "string"] },
              "unit": { "type": ["string", "null"] },
              "comparator": { "enum": ["LE", "LT", "GE", "GT", null] }
            }
          },
          "modality": { "enum": ["ALLOW", "PROHIBIT", "OBLIGE", "EXEMPT", null] },
          "name": { "type": "string", "description": "SUBJECT: 용도지역 명칭 / REFERENCE: 법령명" },
          "value": { "description": "STATUS 전용: REVIEWABLE | CONDITIONAL | MANUAL_CHECK", "enum": ["REVIEWABLE", "CONDITIONAL", "MANUAL_CHECK"] },
          "key_terms": {
            "description": "이 사실을 설명했다고 인정하려면 같은 문장에 있어야 할 핵심어. 원소가 배열이면 그중 하나(동의어)면 됨.",
            "type": "array",
            "items": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 } ] }
          },
          "must_mention": { "type": "boolean", "description": "true 이면 설명에서 빠지면 OMISSION" }
        }
      }
    },
    "dismissed": {
      "description": "원문 후보 중 이 규칙 설명과 무관해 제외한 것. 사유가 없으면 완전성 검사에서 누락으로 잡힌다.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "reason", "reviewer"],
        "properties": {
          "candidate_id": { "type": "string" },
          "reason": { "type": "string", "minLength": 2 },
          "reviewer": { "type": "string" }
        }
      }
    }
  }
}

  "sentences": [
    {
      "sid": "s1",
      "role": "headline",
      "text": "사용승인일부터 1년 이내에 부설주차장을 설치해야 해요.",
      "fact_ids": [
        "F_PERIOD",
        "F_OBL"
      ]
    },
    {
      "sid": "s2",
      "role": "summary",
      "text": "제2종일반주거지역에서 연면적 200㎡ 이상인 건물을 지을 때 적용돼요.",
      "fact_ids": [
        "F_SUBJ",
        "F_AREA"
      ]
    },
    {
      "sid": "s3",
      "role": "meaning",
      "text": "주차 칸의 너비는 2.5m 이상이어야 해요.",
      "fact_ids": [
        "F_WIDTH"
      ]
    },
    {
      "sid": "s4",
      "role": "exception",
      "text": "다만 연면적 200㎡ 미만인 건물은 이 의무에서 제외돼요.",
      "fact_ids": [
        "F_EXC"
      ]
    },
    {
      "sid": "s5",
      "role": "caution",
      "text": "건물 용도와 규모 조건에 따라 달라질 수 있어 확인이 필요해요.",
      "fact_ids": [
        "F_STATUS"
      ]
    }
  ],
  "glossary": [
    {
      "term": "부설주차장",
      "plain": "건물에 딸려 함께 만들어야 하는 주차장"
    }
  ]
}
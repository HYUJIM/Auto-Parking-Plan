# 복사해서 .env 로 쓰세요 (윈도우: copy .env.example .env / 맥: cp .env.example .env)
# .env 는 저장소에 올리지 않습니다. API 키는 서버에만 두고 브라우저에 노출하지 않습니다.

APP_ENV=local
LOG_LEVEL=INFO
# 로컬: H2 파일 DB var/app (기본값, 설정 불필요) / 운영: PostgreSQL (jdbc: 또는 파이썬판과 같은 postgresql:// 형식)
# DATABASE_URL=postgresql://app:app@localhost:5432/app

# 원문 보관소: local 또는 s3
BLOB_STORE=local
# S3_BUCKET=app-law-raw-xxxx
# AWS_REGION=ap-northeast-2

# 외부 공공 API (발급: business.juso.go.kr / vworld.kr / data.go.kr / open.law.go.kr)
JUSO_API_KEY=
VWORLD_API_KEY=
# VWORLD_DOMAIN=서비스 도메인 (브이월드 키 발급 시 등록한 값)
# VWORLD_API_KEY 가 있으면 화면의 배경지도 타일도 브이월드 것을 씁니다 (GET /v1/map/tiles — 서버가 대신 받아 주므로 키는 브라우저에 가지 않음).
# VWORLD_WMTS_URL=https://api.vworld.kr   # 배경지도 타일(WMTS) 주소. 기본값 그대로 두면 됩니다
BUILDING_HUB_KEY=
LAWGO_OC=
EXTERNAL_TIMEOUT_S=3.0

# 로컬 모의 서버를 쓸 때 (java -jar server/build/libs/app.jar mockserver --port 8090)
# JUSO_BASE_URL=http://127.0.0.1:8090
# VWORLD_DATA_URL=http://127.0.0.1:8090
# VWORLD_NED_URL=http://127.0.0.1:8090
# VWORLD_WMTS_URL=http://127.0.0.1:8090
# BUILDING_HUB_URL=http://127.0.0.1:8090

# 프론티어 LLM: anthropic | openai | fake(오프라인 결정적) | none(AI 설명 없이 원문 템플릿만)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_WRITER_MODEL=claude-opus-5-5
LLM_JUDGE_MODEL=claude-sonnet-5-5
LLM_EXTRACTOR_MODEL=claude-opus-5-5
# OpenAI 를 쓸 때: LLM_PROVIDER=openai, OPENAI_API_KEY=..., 모델 이름을 반드시 지정
# 판정 모델만 다른 제공자로: JUDGE_PROVIDER=openai

# 검토 실행: thread(기본, API 프로세스 내) | worker(별도 워커 프로세스, AWS 권장) | inline(테스트)
REVIEW_EXECUTOR=thread

# 관리자(검수) API 토큰. 비워 두면 관리자 API 비활성
# 운영(APP_ENV=prod)은 32자 이상 무작위 값: openssl rand -base64 32  (윈도우 PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
ADMIN_TOKEN=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]  # FE 개발 서버(Vite)는 5173. 운영은 FE 배포 도메인

# 보안 (기본값으로 켜져 있음, 자세한 내용은 docs/SECURITY.md)
# TRUSTED_PROXY_HOPS=0            # 앞단 프록시 수 (AWS ALB 뒤 = 1)
# RATE_LIMIT_ENABLED=true         # 테스트(APP_ENV=test)에서만 기본 꺼짐
# RATE_LIMIT_REVIEWS_PER_MIN=10
# RATE_LIMIT_SEARCH_PER_MIN=30
# RATE_LIMIT_TILES_PER_MIN=1200   # 지도 타일 전용 묶음 (순간 허용량 = 분당/4). 화면 하나가 타일 20~40장을 부릅니다
# MAX_BODY_BYTES=65536
# ADMIN_MAX_FAILURES=10
# ADMIN_LOCK_MINUTES=15
# PARCEL_REFRESH_MIN_INTERVAL_S=600

# nginx 공식 이미지가 시작할 때 ${ORIGIN_SECRET} 만 환경 변수로 바꿔 /etc/nginx/conf.d/default.conf 로 쓴다.
server {
    listen 80 default_server;
    server_tokens off;
    client_max_body_size 64k;

    # api 컨테이너가 새로 뜨면 IP 가 바뀌므로 매번 Docker DNS 로 다시 찾는다
    resolver 127.0.0.11 valid=5s;
    set $api http://api:8000;

    location /v1/ {
        if ($http_x_origin_verify != "${ORIGIN_SECRET}") { return 403; }
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Origin-Verify "";
        proxy_read_timeout 30s;
    }

    location = /healthz {
        if ($http_x_origin_verify != "${ORIGIN_SECRET}") { return 403; }
        proxy_pass $api;
        proxy_set_header X-Origin-Verify "";
    }

    # /admin 을 포함한 나머지는 밖에서 접근할 수 없다
    location / { return 404; }
}

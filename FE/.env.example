# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (.env* 는 .env.example 만 빼고 git 에 올라가지 않습니다)
# 이 템플릿(.env.example)은 저장소에 올라가므로 실제 키를 적지 마세요.
# 공공 API 승인키(도로명주소·브이월드·건축HUB)는 FE 가 아니라 BE(../BE/.env) 에 둡니다 — 브라우저는 BE 의 공개 API(/v1)만 부릅니다.

# 네이버 클라우드 플랫폼(NCP) Maps > Web Dynamic Map 의 "Client ID (ncpKeyId)".
#  - 비워 두면 '미리보기 지도'(자체 그린 도식 지도)로 동작합니다.
#  - NCP 콘솔 > Application 에 서비스 URL(http://localhost:5173 등)을 등록해야 지도가 표시됩니다.
#  - 지도 Client ID 는 브라우저에 노출되는 값이 맞습니다.
VITE_NAVER_MAP_KEY_ID=

# 네이버 키가 없을 때 미리보기 지도가 아래에 까는 배경 타일 URL 템플릿({z} {x} {y}). 보통은 비워 둡니다.
#  - 둘 다 비우면 BE 에 물어봅니다 (GET /v1/map/config): BE 에 브이월드 키가 있으면 BE 가 대신 받아 주는 브이월드 타일(/v1/map/tiles)을 씁니다.
#    필지 경계가 브이월드 연속지적도라서 브이월드 지도 위에서만 건물·도로와 정확히 맞습니다. 인증키는 BE 에만 있고 브라우저로 오지 않습니다.
#  - BE 에 브이월드 키가 없거나 BE 를 못 부르면 OpenStreetMap(일반) · Esri World Imagery(위성)로 대체합니다 — 국내 지적과 6~10m 어긋나 보일 수 있습니다.
#    OSM 타일 서버는 개발·소규모용입니다 (https://operations.osmfoundation.org/policies/tiles/).
#  - 여기에 템플릿을 적으면 BE 에 묻지 않고 그 타일을 씁니다. `off` 면 타일 없이 도식 격자만 그립니다(오프라인).
#    직접 지정했으면 하단 출처 문구(src/content/ko.json 의 map.sourceTilesCustom)와 배포 CSP 의 img-src 호스트도 같이 바꾸세요.
VITE_MAP_TILE_URL=
# '위성' 레이어용 템플릿 (이것만 적어도 BE 에 묻지 않습니다). VITE_MAP_TILE_URL 을 적었을 때: 비우면 Esri World Imagery, `off` 면 일반 타일을 그대로 씁니다.
VITE_MAP_TILE_URL_SATELLITE=

# BE 공개 API 의 origin (예: https://api.example.com). FE 를 정적 호스팅하고 BE 를 브라우저가 직접 부를 때만 채웁니다.
#  - 개발 중에는 비워 둡니다: 같은 origin 의 /v1 을 부르고 Vite 개발 서버가 BE 로 프록시합니다 (CORS 불필요).
#  - 채우면 BE 의 CORS_ORIGINS 에 FE origin 을 넣어야 합니다 (BE/.env.example 참고).
VITE_API_BASE=

# 개발·미리보기 서버가 /v1 을 넘길 BE 주소. 비우면 http://127.0.0.1:8000 (BE README 의 `serve --port 8000`).
#  - 셸 환경변수로 줘도 됩니다: VITE_PROXY_TARGET=http://127.0.0.1:9000 npm run dev
VITE_PROXY_TARGET=

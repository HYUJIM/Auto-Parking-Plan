# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (.env* 는 .env.example 만 빼고 git 에 올라가지 않습니다)
# 이 템플릿(.env.example)은 저장소에 올라가므로 실제 키를 적지 마세요.

# ───────────── 브라우저에 노출되는 값 (VITE_ 접두사) ─────────────

# 네이버 클라우드 플랫폼(NCP) Maps > Web Dynamic Map 의 "Client ID (ncpKeyId)".
#  - 비워 두면 '미리보기 지도'(자체 그린 도식 지도)로 동작합니다.
#  - NCP 콘솔 > Application 에 서비스 URL(http://localhost:5173 등)을 등록해야 지도가 표시됩니다.
#  - 지도 Client ID 는 브라우저에 노출되는 값이 맞습니다.
VITE_NAVER_MAP_KEY_ID=

# FE 를 정적 호스팅하고 API 서버(npm run api)를 따로 띄울 때 그 주소. 개발 중에는 비워 둡니다(같은 origin 의 /api 사용).
VITE_API_BASE=

# 목업 API 가 일부러 실패하는 비율(0~1). 로딩/오류/다시 시도 UI 를 확인할 때 0.3 등으로 올려 보세요. (단위 테스트는 항상 0 으로 돕니다)
VITE_MOCK_FAIL_RATE=0

# ───────────── 서버에서만 쓰는 값 (VITE_ 접두사 없음 → 번들에 포함되지 않음) ─────────────

# 행정안전부 도로명주소 API 승인키 — https://business.juso.go.kr > API 신청 > "검색 API"
#  - 비워 두면 /api/address 가 목업 필지 목록으로 응답합니다(검색 결과 목록 아래에 '목업 주소 데이터' 표시).
JUSO_API_KEY=

# 도로명주소 "좌표제공 API" 승인키 (검색 API 와 별도 신청). 있으면 검색 결과에 좌표가 붙어 지도에 미리보기 핀이 찍힙니다.
JUSO_COORD_API_KEY=

# 브이월드(VWorld) 오픈API 인증키 — https://www.vworld.kr > 오픈API > 인증키 발급 (서비스 URL 에 http://localhost:5173 등록)
#  - 연속지적도(필지 경계)·토지특성(면적·지목·용도지역·도로접면·공시지가)·토지이용계획(지역·지구) 조회에 사용
#  - 비워 두면 /api/parcel 이 목업 필지만 돌려줍니다.
VWORLD_API_KEY=
# 브이월드 키 발급 때 등록한 서비스 도메인 (예: localhost:5173). 비우면 localhost:5173
VWORLD_DOMAIN=

# ───────────── 독립 실행 API 서버 (npm run api) ─────────────

# 바인드 주소·포트. API_HOST 를 비우면 개발은 127.0.0.1(같은 PC 만), 운영(NODE_ENV=production)은 0.0.0.0
API_HOST=
API_PORT=8787

# 허용 origin (쉼표로 여러 개, 예: https://app.example.com,https://www.example.com)
#  - 비우면 어떤 origin 에도 CORS 헤더를 주지 않아 브라우저 요청이 전부 차단됩니다 (안전한 기본값).
#  - '*' 는 모든 origin 을 허용하므로 개발용으로만 직접 적어 쓰고, 운영(NODE_ENV=production)에서는 거부됩니다.
CORS_ORIGIN=http://localhost:5173

# IP 당 분당 요청 수 제한. 0 이면 끔 (API Gateway·WAF 의 속도 제한을 쓸 때)
RATE_LIMIT_PER_MIN=60

# 앞단 프록시 단계 수. CloudFront·ALB·nginx 뒤에 두면 1 — 그래야 모든 사용자가 프록시 IP 하나로 묶여 함께 429 를 받지 않습니다.
# 프록시 없이 직접 노출할 때는 0 (X-Forwarded-For 를 신뢰하지 않음)
TRUST_PROXY=0

# 공공 API 호출 예산 (프로세스 전체). 분당 호출 수 / 동시 호출 수. 넘으면 503 BUSY 로 답하고 승인키 일일 한도를 지킵니다. 0 이면 제한 없음
UPSTREAM_PER_MIN=600
UPSTREAM_MAX_INFLIGHT=32
